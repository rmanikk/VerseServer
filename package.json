{
  "name": "verseserver",
  "version": "1.0.0",
  "private": true,
  "description": "Music infrastructure and API platform for VerseHana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "argon2@0.45.2": true
  }
}
